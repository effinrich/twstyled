{
  "name": "tw-styled-ui",
  "version": "0.0.1",
  "description": "Pre-built tw-styled UI components compatible with shadcn token patterns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richtillman/twstyled.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/richtillman/twstyled/issues"
  },
  "homepage": "https://github.com/richtillman/twstyled#readme",
  "keywords": [
    "react",
    "ui",
    "tailwind",
    "shadcn",
    "tw-styled"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./radix": {
      "types": "./dist/radix.d.ts",
      "import": "./dist/radix.js",
      "require": "./dist/radix.cjs"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js",
      "require": "./dist/base.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwind-merge": "^2",
    "tw-styled": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-checkbox": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-select": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^26.0.0",
    "tsup": "^8.3.6",
    "vitest": "^3.0.5"
  }
}
